{
    "name": "@svs-tm/ci-cd",
    "version": "1.0.0",
    "description": "CI/CD collection",
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "private": true,
    "packageManager": "pnpm@12.16.1",
    "sideEffects": false,
    "scripts":
    {
        "build": "pnpm -r run build",
        "prepare": "husky",
        "typecheck": "tsc --project tsconfig.typecheck.json --noEmit"
    },
    "keywords": [],
    "author": "svs-tm",
    "license": "MIT",
    "dependencies":
    {
        "@actions/core": "^3.0.1",
        "@actions/exec": "^3.0.0",
        "@actions/github": "^9.1.1",
        "http-status-codes": "^2.3.0",
        "tar": "^7.5.22",
        "unzip-stream": "^0.3.4",
        "zod": "^4.6.7"
    },
    "devDependencies":
    {
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.1",
        "@types/node": "^24.19.2",
        "@types/unzip-stream": "^0.3.4",
        "husky": "^9.1.7",
        "rollup": "^4.67.4",
        "tslib": "^2.9.1",
        "typescript": "^6.0.3"
    },
    "devEngines":
    {
        "packageManager":
        {
            "name": "pnpm",
            "version": "12.16.1",
            "onFail": "download"
        },
        "runtime":
        {
            "name": "node",
            "version": "26.13.0",
            "onFail": "download"
        }
    }
}
