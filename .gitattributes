# Rollup emits LF; keep generated bundles consistent across platforms.
.github/actions/**/dist/* text eol=lf
.gitattributes text eol=lf
pnpm-lock.yaml text eol=lf

# Include handwritten action sources in GitHub language detection.
.github/actions/**/src/**/*.ts linguist-detectable=true linguist-vendored=false linguist-generated=false
